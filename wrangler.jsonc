{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "studio-x-pwa",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "account_id": "95a6a515ebd3e79bf9ada23c38e6c1e4",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  }
}
